# EAS Build ignore — identique à .gitignore SAUF que google-services.json
# et GoogleService-Info.plist sont inclus (nécessaires pour le build natif)

# Secrets (sauf Firebase qui doit être embarqué dans le build)
.env
.env.local
.env.*.local
*.pem
*.key

# dependencies / Node
node_modules/
npm-debug.log*

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.mobileprovision

# Metro
.metro-health-check*

# debug
yarn-debug.*
yarn-error.*

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# EAS
eas-build-local-nodejs/

# TypeScript
*.tsbuildinfo

# local env files
.env.txt

# generated native folders
/ios
/android

# EAS local build output
build/

# Claude Code internals
.claude/worktrees/
.claude/skills/

# Rapports de session (internes)
AUDIT_*.md
AUDIT_*.docx
RAPPORT_*.md
